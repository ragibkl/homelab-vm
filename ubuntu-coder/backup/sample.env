# /etc/coder-backup/env (root, mode 600). Real values: the user's password
# manager and ~/.config/wasabi/coder-backup.env in the Coder workspace.
# Wasabi IAM user coder-backup can only reach bucket ragib-coder-backup
# (versioned; it can't delete old versions).
RESTIC_REPOSITORY=s3:https://s3.ap-southeast-1.wasabisys.com/ragib-coder-backup/coder-db
# Needed for every restore. Lose it and the backups are unreadable.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
# The gatus-push NodePort on each vmbr1 k3s node; only the node running
# Gatus answers. Token: CODER_BACKUP_PUSH_TOKEN in flux-deploy gatus-secret.
GATUS_PUSH_URLS="http://10.15.1.21:30808 http://10.15.1.22:30808 http://10.15.1.11:30808"
GATUS_PUSH_TOKEN=
