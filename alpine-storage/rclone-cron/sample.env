# Garage, read-only key for the offsite copy:
#   garage key create offsite-sync
#   garage bucket allow --read <bucket> --key offsite-sync
RCLONE_CONFIG_GARAGE_TYPE=s3
RCLONE_CONFIG_GARAGE_PROVIDER=Other
RCLONE_CONFIG_GARAGE_ENDPOINT=http://127.0.0.1:3900
RCLONE_CONFIG_GARAGE_REGION=garage
RCLONE_CONFIG_GARAGE_ACCESS_KEY_ID=
RCLONE_CONFIG_GARAGE_SECRET_ACCESS_KEY=

# Wasabi: the bucket-scoped IAM user for the bucket (e.g. "nextcloud").
RCLONE_CONFIG_WASABI_TYPE=s3
RCLONE_CONFIG_WASABI_PROVIDER=Wasabi
RCLONE_CONFIG_WASABI_ENDPOINT=s3.ap-southeast-1.wasabisys.com
RCLONE_CONFIG_WASABI_REGION=ap-southeast-1
RCLONE_CONFIG_WASABI_ACCESS_KEY_ID=
RCLONE_CONFIG_WASABI_SECRET_ACCESS_KEY=

# Only for initial-copy.sh: a Garage key with write access.
RCLONE_CONFIG_GARAGEW_TYPE=s3
RCLONE_CONFIG_GARAGEW_PROVIDER=Other
RCLONE_CONFIG_GARAGEW_ENDPOINT=http://127.0.0.1:3900
RCLONE_CONFIG_GARAGEW_REGION=garage
RCLONE_CONFIG_GARAGEW_ACCESS_KEY_ID=
RCLONE_CONFIG_GARAGEW_SECRET_ACCESS_KEY=
